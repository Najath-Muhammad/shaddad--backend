datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum DriverVerificationStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  BUSY
}

enum VehicleType {
  DYNA
  PICKUP_SMALL
  PICKUP_LARGE
  TRAILER
  FLATBED
  REFRIGERATED
  BOX_TRUCK
}

model User {
  id           String        @id @default(uuid())
  phoneNumber  String        @unique
  email        String?       @unique
  passwordHash String
  fullName     String
  role         UserRole      @default(CUSTOMER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  refreshTokens   RefreshToken[]

  @@index([phoneNumber])
  @@index([email])
  @@index([role])
  @@map("users")
}

model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress  String?
  rating          Float    @default(5.0)
  totalTripsCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trips           Trip[]

  @@map("customer_profiles")
}

model DriverProfile {
  id                   String                   @id @default(uuid())
  userId               String                   @unique
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalIdNumber     String?                  @unique
  licenseNumber        String?                  @unique
  verificationStatus   DriverVerificationStatus @default(PENDING_VERIFICATION)
  availability         DriverAvailability       @default(OFFLINE)
  currentLatitude      Float?
  currentLongitude     Float?
  lastLocationAt       DateTime?
  rating               Float                    @default(5.0)
  totalTripsCount      Int                      @default(0)
  walletBalance        Decimal                  @default(0.00) @db.Decimal(12, 2)

  // Documents
  nationalIdFrontUrl   String?
  nationalIdBackUrl    String?
  licenseUrl           String?
  profilePhotoUrl      String?
  licenseExpiryDate    DateTime?
  nationalIdExpiryDate DateTime?

  // Verification tracking
  verifiedAt           DateTime?
  verifiedByAdminId    String?
  rejectionReason      String?
  suspensionReason     String?

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  vehicle              Vehicle?
  trips                Trip[]

  @@index([verificationStatus])
  @@index([availability])
  @@map("driver_profiles")
}

model Vehicle {
  id                  String      @id @default(uuid())
  driverProfileId     String      @unique
  driverProfile       DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicleType         VehicleType
  make                String
  model               String
  year                Int
  plateNumber         String      @unique
  color               String
  maxWeightKg         Float
  maxLengthCm         Float?
  isRefrigerated      Boolean     @default(false)
  isVerified          Boolean     @default(false)

  // Vehicle Documents
  registrationUrl     String?
  registrationExpiry  DateTime?
  insuranceUrl        String?
  insuranceExpiry     DateTime?
  vehiclePhotoUrl     String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([vehicleType])
  @@index([plateNumber])
  @@map("vehicles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

enum TripStatus {
  PENDING_DRIVER_RESPONSE
  ACCEPTED
  REJECTED
  EXPIRED
}

model Trip {
  id                     String           @id @default(uuid())
  customerId             String
  customer               CustomerProfile  @relation(fields: [customerId], references: [id])
  driverId               String
  driver                 DriverProfile    @relation(fields: [driverId], references: [id])

  // Location Details
  pickupLatitude         Float
  pickupLongitude        Float
  pickupAddress          String
  destinationLatitude    Float
  destinationLongitude   Float
  destinationAddress     String
  distanceKm             Float

  // Schedule
  pickupDateTime         DateTime

  // Cargo Details
  cargoType              String
  weightKg               Float
  quantity               Int
  additionalRequirements String?

  // Financials
  baseFare               Decimal          @db.Decimal(10, 2)
  distanceCharge         Decimal          @db.Decimal(10, 2)
  vehicleCharge          Decimal          @db.Decimal(10, 2)
  weightCharge           Decimal          @db.Decimal(10, 2)
  subtotal               Decimal          @db.Decimal(10, 2)
  commission             Decimal          @db.Decimal(10, 2)
  driverEarnings         Decimal          @db.Decimal(10, 2)
  totalPrice             Decimal          @db.Decimal(10, 2)

  status                 TripStatus       @default(PENDING_DRIVER_RESPONSE)
  expiresAt              DateTime

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  statusHistory          TripStatusHistory[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@map("trips")
}

model TripStatusHistory {
  id          String     @id @default(uuid())
  tripId      String
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status      TripStatus
  reason      String?
  changedById String?
  createdAt   DateTime   @default(now())

  @@index([tripId])
  @@map("trip_status_history")
}

model PricingConfig {
  id                   String      @id @default(uuid())
  vehicleType          VehicleType @unique
  baseFare             Decimal     @db.Decimal(10, 2)
  perKmRate            Decimal     @db.Decimal(10, 2)
  perKgRate            Decimal     @db.Decimal(10, 2)
  commissionPercentage Decimal     @db.Decimal(5, 2)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  
  @@map("pricing_configs")
}
