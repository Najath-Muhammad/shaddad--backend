datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum DriverVerificationStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  BUSY
}

enum VehicleType {
  DYNA
  PICKUP_SMALL
  PICKUP_LARGE
  TRAILER
  FLATBED
  REFRIGERATED
  BOX_TRUCK
}

model User {
  id           String        @id @default(uuid())
  phoneNumber  String        @unique
  email        String?       @unique
  passwordHash String
  fullName     String
  role         UserRole      @default(CUSTOMER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  refreshTokens   RefreshToken[]

  @@index([phoneNumber])
  @@index([email])
  @@index([role])
  @@map("users")
}

model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress  String?
  rating          Float    @default(5.0)
  totalTripsCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("customer_profiles")
}

model DriverProfile {
  id                   String                   @id @default(uuid())
  userId               String                   @unique
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalIdNumber     String?                  @unique
  licenseNumber        String?                  @unique
  verificationStatus   DriverVerificationStatus @default(PENDING_VERIFICATION)
  availability         DriverAvailability       @default(OFFLINE)
  currentLatitude      Float?
  currentLongitude     Float?
  lastLocationAt       DateTime?
  rating               Float                    @default(5.0)
  totalTripsCount      Int                      @default(0)
  walletBalance        Decimal                  @default(0.00) @db.Decimal(12, 2)

  // Documents
  nationalIdFrontUrl   String?
  nationalIdBackUrl    String?
  licenseUrl           String?
  profilePhotoUrl      String?
  licenseExpiryDate    DateTime?
  nationalIdExpiryDate DateTime?

  // Verification tracking
  verifiedAt           DateTime?
  verifiedByAdminId    String?
  rejectionReason      String?
  suspensionReason     String?

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  vehicle              Vehicle?

  @@index([verificationStatus])
  @@index([availability])
  @@map("driver_profiles")
}

model Vehicle {
  id                  String      @id @default(uuid())
  driverProfileId     String      @unique
  driverProfile       DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicleType         VehicleType
  make                String
  model               String
  year                Int
  plateNumber         String      @unique
  color               String
  maxWeightKg         Float
  maxLengthCm         Float?
  isRefrigerated      Boolean     @default(false)
  isVerified          Boolean     @default(false)

  // Vehicle Documents
  registrationUrl     String?
  registrationExpiry  DateTime?
  insuranceUrl        String?
  insuranceExpiry     DateTime?
  vehiclePhotoUrl     String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([vehicleType])
  @@index([plateNumber])
  @@map("vehicles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}
